# --- Supabase (required for publishing/browsing shared dishes) ---
# Create a free project at https://supabase.com, then run db/schema.sql
# once in its SQL editor. URL and anon key are under Project Settings -> API.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: server-only, used by /api/admin/* to
# hide/unhide/delete reported posts. NEVER prefix this with VITE_ — that
# would ship it to the browser. Find it on the same API settings page.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Vercel Blob (required for photo uploads) ---
# Vercel dashboard -> your project -> Storage tab -> Create/Connect a Blob
# store. Vercel auto-injects this when deployed; for local dev, copy the
# token from the Storage tab.
BLOB_READ_WRITE_TOKEN=""

# --- Gemini AI (optional) ---
# A server-wide fallback key, used only when a visitor hasn't set their own
# in Settings. Get one at https://aistudio.google.com/apikey. Leave unset
# to require every visitor to bring their own key.
GEMINI_API_KEY=""

# --- Admin moderation (required to use /api/admin/*) ---
# Any random string, e.g.: openssl rand -hex 32
ADMIN_SECRET=""
