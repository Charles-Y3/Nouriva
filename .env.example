# --- Supabase (required for publishing/browsing shared dishes) ---
# Create a free project at https://supabase.com, then run db/schema.sql
# once in its SQL editor. URL and anon key are under Project Settings -> API.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: server-only, used by /api/admin/* to
# hide/unhide/delete reported posts. NEVER prefix this with VITE_ — that
# would ship it to the browser. Find it on the same API settings page.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Vercel Blob (required for photo uploads) ---
# Vercel dashboard -> your project -> Storage tab -> Create/Connect a Blob
# store. Vercel auto-injects this when deployed; for local dev, copy the
# token from the Storage tab.
BLOB_READ_WRITE_TOKEN=""

# --- AI provider (optional) ---
# Server-wide fallback, used only when a visitor hasn't set their own in
# Settings. Generic OpenAI-compatible chat-completions client — works with
# Groq (default below, has a free tier: https://console.groq.com/keys),
# OpenAI, Gemini's own OpenAI-compatibility endpoint
# (https://generativelanguage.googleapis.com/v1beta/openai), Together,
# Fireworks, or a local runtime (Ollama, LM Studio). Leave AI_API_KEY unset
# to require every visitor to bring their own key.
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_API_KEY=""
AI_MODEL="qwen/qwen3.8-27b"

# --- Admin moderation (required to use /api/admin/*) ---
# Any random string, e.g.: openssl rand -hex 32
ADMIN_SECRET=""

# --- Post screening (new/edited posts are AI-checked before going public) ---
# Any OpenAI-compatible key; reuses the AI provider settings above if you
# prefer. A key starting "gsk_" is a Groq key (https://console.groq.com/keys),
# "xai-" is xAI's Grok. XAI_API_KEY is accepted as an alias. Without a key,
# every new post waits for admin review instead of going live.
MODERATION_API_KEY=""
# MODERATION_BASE_URL=""   # default: Groq, or api.x.ai for an xai- key
# MODERATION_MODEL=""      # default: AI_MODEL, else qwen/qwen3.8-27b (must accept images)

# --- Translation (optional; uses the key above if nothing here is set) ---
# Every post gets a version in the other language. On Groq the default model is
# openai/gpt-oss-120b (the moderation model's free tier allows only 1,000 output tokens/minute).
# TRANSLATE_API_KEY=""
# TRANSLATE_BASE_URL=""
# TRANSLATE_MODEL=""

# --- Email alert when a post is waiting for review (optional) ---
# Free account at https://resend.com -> API Keys. With the default sender
# (onboarding@resend.dev) Resend only delivers to the email you signed up with,
# which is exactly what a single admin needs.
RESEND_API_KEY=""
ADMIN_EMAIL=""
# RESEND_FROM="Nouriva <alerts@your-verified-domain>"
# APP_URL="https://nouriva.qolife.app"
